# Sanity project — see https://www.sanity.io/manage to find these
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production

# Modem Pay publishable key, from the merchant dashboard's API keys page.
# pk_test_… uses the sandbox checkout, pk_live_… uses the real one — the code
# picks the endpoint off this prefix, so there is no separate "mode" setting.
# Safe to expose: it only identifies the merchant and cannot move money.
# If unset, the donate page falls back to the plain Modem Pay payment link.
PUBLIC_MODEM_PAY_KEY=pk_test_your-key

# Modem Pay SECRET key — NOT used by the site build and NOT PUBLIC_-prefixed.
# Only needed if a backend is ever added (payouts, refunds, webhook handling).
# Anything PUBLIC_-prefixed is inlined into the browser bundle, so this must
# never gain that prefix.
MODEM_PAY_TEST_SECRET_KEY=sk_test_your-key
