---
/**
 * pages/donate.astro
 * Donate page — imports sections only. Zero design logic or inline
 * classes here. Content sourced from Sanity donatePage.
 *
 * The page asks one question and then narrows, rather than offering three
 * parallel options and leaving the donor to work out which applies to them:
 *
 *   1. PageHero      — slim branded banner
 *   2. GiveOnline    — "where are you giving from?" Gambian donors pay via
 *                      Modem Pay, donors abroad go to GoFundMe (bg-bg-base)
 *   3. BankTransfer  — plain reference block for institutional gifts, last
 *                      of the giving methods (bg-white)
 *   4. OtherWaysCTA  — closes the page on a different intent entirely: how
 *                      to help without giving money (bg-bg-base)
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/ui/PageHero.astro';
import GiveOnline from '@components/sections/page/donate/GiveOnline.astro';
import BankTransfer from '@components/sections/page/donate/BankTransfer.astro';
import OtherWaysCTA from '@components/sections/page/donate/OtherWaysCTA.astro';
import { getSiteSettings, getDonatePage } from '@lib/sanity/queries';

const [site, donate] = await Promise.all([getSiteSettings(), getDonatePage()]);
---

<BaseLayout
	title='Donate'
	description={`Support ${site.org.name} and help us empower communities through education, health, and community development.`}
>
	<PageHero
		title={donate.hero.title}
		subtitle={donate.hero.subtitle}
		breadcrumb={donate.hero.breadcrumb}
		backgroundImage={donate.hero.backgroundImage}
	/>
	<GiveOnline
		data={donate.onlineGiving}
		campaign={site.activeCampaign}
	/>
	<BankTransfer
		data={donate.bankTransferSection}
		orgName={site.org.name}
	/>
	<OtherWaysCTA data={donate.otherWaysSection} />
</BaseLayout>
