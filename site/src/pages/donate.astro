---
/**
 * pages/donate.astro
 * Donate page — imports sections only. Zero design logic or inline
 * classes here. Content sourced from Sanity donatePage. Bank/mobile money
 * values are still placeholders there — update them in Studio, not this
 * file, once real details are ready.
 *
 * Section order:
 *   1. PageHero      — slim branded banner
 *   2. OnlineGiving  — Modem Pay checkout, the primary path (bg-bg-base)
 *   3. WaysToGive    — bank transfer + mobile money details (bg-white)
 *   4. OtherWaysCTA  — volunteer / contact fallback (bg-bg-base)
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/ui/PageHero.astro';
import OnlineGiving from '@components/sections/page/donate/OnlineGiving.astro';
import WaysToGive from '@components/sections/page/donate/WaysToGive.astro';
import OtherWaysCTA from '@components/sections/page/donate/OtherWaysCTA.astro';
import { getSiteSettings, getDonatePage } from '@lib/sanity/queries';

const [site, donate] = await Promise.all([getSiteSettings(), getDonatePage()]);
---

<BaseLayout
	title='Donate'
	description={`Support ${site.org.name} and help us empower communities through education, health, and community development.`}
>
	<PageHero
		title={donate.hero.title}
		subtitle={donate.hero.subtitle}
		breadcrumb={donate.hero.breadcrumb}
		backgroundImage={donate.hero.backgroundImage}
	/>
	<OnlineGiving
		data={donate.onlineGiving}
		campaign={site.activeCampaign}
	/>
	<WaysToGive
		data={donate.waysToGiveSection}
		orgName={site.org.name}
	/>
	<OtherWaysCTA
		data={donate.otherWaysSection}
		activeCampaign={site.activeCampaign}
	/>
</BaseLayout>
