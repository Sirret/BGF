---
/**
 * OtherWaysCTA.astro
 * Donate page closer — for people who want to help but not with money.
 * Background: bg-bg-base
 *
 * The active-campaign card that used to sit here has moved into
 * GiveOnline.astro, where it is the route for donors outside The Gambia.
 * Showing the same GoFundMe link twice on one page just made the page read
 * as three competing asks instead of one path. (CampaignBanner.astro on
 * /projects still surfaces the campaign in its own right.)
 *
 * Props:
 *   data — otherWaysSection object from Sanity
 */

import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';

const { data } = Astro.props;
---

<section class='bg-bg-base py-24'>
	<div
		class='max-w-3xl mx-auto px-6 flex flex-col items-center text-center gap-8'
	>
		<SectionHeading
			label={data.label}
			title={data.title}
			subtitle={data.subtitle}
		/>
		<div class='flex flex-wrap justify-center gap-4'>
			<Button
				variant='accent'
				href='/get-involved'
				>Volunteer With Us</Button
			>
			<Button
				variant='outline'
				href='/contact'
				>Get in Touch</Button
			>
		</div>
	</div>
</section>
