---
/**
 * GiveOnline.astro
 * Donate page — the one giving decision, framed as "where are you giving
 * from?" because that answer picks the payment rail for the donor:
 *
 *   In The Gambia   -> Modem Pay (Wave / QMoney / AfriMoney / card, in GMD)
 *   Outside Gambia  -> the GoFundMe campaign, which handles their currency
 *
 * That split is deliberate rather than cosmetic. Modem Pay settles in GMD
 * only and charges 7.5% on cards against 1.25% on mobile money, so routing
 * overseas donors to GoFundMe avoids both the worse rate and the unresolved
 * question of whether Modem Pay accepts non-Gambian-issued cards.
 *
 * Background: bg-bg-base
 *
 * Why a plain form POST and not the Modem Pay SDK: the SDK needs the secret
 * key, which needs a server, and this site is a static build. HTML Checkout
 * takes only the public key, so the flow works on GitHub Pages as-is. The
 * test/live endpoint is derived from the key prefix rather than a second env
 * var, so the two can never disagree.
 *
 * Props:
 *   data     — donatePage.onlineGiving
 *   campaign — siteSettings.activeCampaign; drives the international card,
 *              which is hidden entirely when no campaign is running
 */

import SectionHeading from '@components/ui/SectionHeading.astro';
import { withBase } from '@components/utils/paths';

const { data, campaign } = Astro.props;

const local = data?.local;
const international = data?.international;

const publicKey = import.meta.env.PUBLIC_MODEM_PAY_KEY;
const isLive = publicKey?.startsWith('pk_live_');
const endpoint = isLive
	? 'https://checkout.modempay.com/api/pay'
	: 'https://test.checkout.modempay.com/api/pay';

// Modem Pay needs absolute return URLs, and this site is served from a
// subpath, so both the origin and the base have to be baked in.
const absolute = (path: string) => new URL(withBase(path)!, Astro.site).href;

const minAmount = local?.minAmount ?? 10;
// Only a starting ladder; whatever is set in Studio wins.
const presets: number[] = local?.presetAmounts?.length
	? local.presetAmounts
	: [250, 1000, 2500, 7500];

const gmd = new Intl.NumberFormat('en-GM', { maximumFractionDigits: 0 });

const showInternational = Boolean(campaign?.active && campaign?.url);
---

<section
	class='bg-bg-base py-24'
	id='give'
>
	<div class='max-w-3xl mx-auto px-6 flex flex-col items-center gap-12'>
		<SectionHeading
			label={data?.label}
			title={data?.title}
			subtitle={data?.subtitle}
		/>

		<!-- Primary rail: donors inside The Gambia -->
		<div
			class='w-full rounded-2xl border-2 border-accent bg-white p-8 sm:p-10 flex flex-col gap-6'
		>
			<div class='flex flex-col gap-2'>
				{
					local?.label && (
						<span class='text-xs font-heading font-semibold uppercase tracking-widest text-accent'>
							{local.label}
						</span>
					)
				}
				<h3 class='font-heading text-2xl font-bold text-text-dark'>
					{local?.title ?? 'Giving from The Gambia'}
				</h3>
				{
					local?.description && (
						<p class='text-base text-text-muted'>{local.description}</p>
					)
				}
			</div>

			{
				publicKey ? (
					<form
						method='POST'
						action={endpoint}
						data-donate-form
						data-min={minAmount}
						class='flex flex-col gap-6'
					>
						<input type='hidden' name='public_key' value={publicKey} />
						<input type='hidden' name='currency' value='GMD' />
						<input
							type='hidden'
							name='return_url'
							value={absolute('/donate/success')}
						/>
						<input
							type='hidden'
							name='cancel_url'
							value={absolute('/donate/cancelled')}
						/>
						<input
							type='hidden'
							name='metadata'
							value={campaign?.active ? campaign.title : 'General donation'}
						/>
						{/* Set by donate-amount.js from whichever control the donor used. */}
						<input type='hidden' name='amount' value='' data-amount-field />

						<fieldset class='flex flex-col gap-3'>
							<legend class='font-heading text-sm font-semibold text-text-dark mb-2'>
								Choose an amount
							</legend>
							<div class='grid grid-cols-2 sm:grid-cols-4 gap-3'>
								{presets.map((amount) => (
									<button
										type='button'
										data-amount={amount}
										aria-pressed='false'
										class='rounded-xl border-2 border-border bg-white px-4 py-4 font-heading text-lg font-bold transition-all duration-200 hover:border-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white cursor-pointer'
									>
										D{gmd.format(amount)}
									</button>
								))}
							</div>
						</fieldset>

						<div class='flex flex-col gap-2'>
							<label
								for='custom-amount'
								class='font-heading text-sm font-semibold text-text-dark'
							>
								Or enter your own amount
							</label>
							<div class='flex items-center gap-3'>
								<span class='font-heading text-lg font-bold text-text-muted'>D</span>
								<input
									type='number'
									id='custom-amount'
									inputmode='numeric'
									min={minAmount}
									step='1'
									placeholder={`${minAmount} or more`}
									data-custom-amount
									class='flex-1 rounded-xl border-2 border-border bg-white px-4 py-3 font-heading text-base text-text-dark placeholder:text-text-muted/60 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2'
								/>
							</div>
						</div>

						<p
							data-form-status
							class='hidden text-sm font-semibold'
							role='status'
							aria-live='polite'
						>
						</p>

						<button
							type='submit'
							class='inline-flex items-center justify-center font-heading font-semibold rounded-full transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 cursor-pointer px-8 py-4 text-lg bg-accent text-white hover:bg-accent-dark focus:ring-accent'
						>
							Continue to secure payment
						</button>

						{local?.currencyNote && (
							<p class='text-sm text-text-muted'>{local.currencyNote}</p>
						)}

						{!isLive && (
							<p class='text-xs font-semibold uppercase tracking-widest text-accent'>
								Test mode: no real money will move
							</p>
						)}

						{local?.shareLink && (
							<noscript>
								<p class='text-sm text-text-muted'>
									The amount picker needs JavaScript.{' '}
									<a
										href={local.shareLink}
										class='text-accent underline underline-offset-4'
									>
										Use our payment link instead
									</a>
									.
								</p>
							</noscript>
						)}
					</form>
				) : (
					/* No key at build time (e.g. CI without the env var) — fall back to
					   the reusable link rather than ship a form that silently fails. */
					local?.shareLink && (
						<a
							href={local.shareLink}
							class='self-start inline-flex items-center justify-center font-heading font-semibold rounded-full transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 cursor-pointer px-8 py-4 text-lg bg-accent text-white hover:bg-accent-dark focus:ring-accent'
						>
							Donate now
						</a>
					)
				)
			}
		</div>

		<!-- Secondary rail: donors abroad, sent to the multi-currency campaign -->
		{
			showInternational && (
				<div class='w-full rounded-2xl border border-border bg-white p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6'>
					<div class='flex flex-col gap-2'>
						{international?.label && (
							<span class='text-xs font-heading font-semibold uppercase tracking-widest text-accent'>
								{international.label}
							</span>
						)}
						<h3 class='font-heading text-xl font-bold text-text-dark'>
							{international?.title ?? 'Giving from outside The Gambia'}
						</h3>
						<p class='text-sm text-text-muted'>
							{international?.description ??
								'Donate in your own currency through our GoFundMe campaign.'}
						</p>
					</div>
					<a
						href={campaign.url}
						target='_blank'
						rel='noopener noreferrer'
						class='shrink-0 inline-flex items-center justify-center font-heading font-semibold rounded-full transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 cursor-pointer px-6 py-3 text-base border-2 border-accent text-accent hover:bg-accent hover:text-white focus:ring-accent'
					>
						{campaign.ctaLabel}
					</a>
				</div>
			)
		}
	</div>
</section>

<script
	is:inline
	src={withBase('/scripts/donate-amount.js')}
	defer
></script>
